# Alchitry Cu (iCE40HX8K-CB132) — clock and LED pins per the Alchitry
# base project. CONFIDENCE: high, but VERIFY against alchitry.pcf/schematic.
set_io clk100 P7
set_io led[0] J11
set_io led[1] K11
set_io led[2] K12
set_io led[3] K14
set_io led[4] L12
set_io led[5] L14
set_io led[6] M12
set_io led[7] N14
# Br-bank pins below are BEST GUESSES — verify against the Cu schematic
# before wiring anything; wrong guesses only mean silence, not damage.
set_io audio    A5
set_io fake_osc A6
set_io pitch_in A7
