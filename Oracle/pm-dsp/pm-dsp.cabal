cabal-version: 2.4
name: pm-dsp
version: 0.1.0.0
synopsis: Oracle DSP cores - Goertzel CW tone detector, AM demodulator, SDR DDC
build-type: Simple

common shared
  default-language: Haskell2010
  ghc-options: -Wall -fplugin GHC.TypeLits.Extra.Solver -fplugin GHC.TypeLits.Normalise -fplugin GHC.TypeLits.KnownNat.Solver
  build-depends: base, Cabal, clash-prelude >= 1.8, ghc-typelits-natnormalise, ghc-typelits-extra, ghc-typelits-knownnat
  default-extensions:
    BangPatterns BinaryLiterals ConstraintKinds DataKinds DefaultSignatures
    DeriveAnyClass DeriveGeneric DerivingStrategies FlexibleContexts
    KindSignatures MagicHash NoStarIsType NumericUnderscores
    ScopedTypeVariables TemplateHaskell TypeApplications TypeFamilies
    TypeOperators NoImplicitPrelude

library
  import: shared
  hs-source-dirs: src
  exposed-modules: PM.Goertzel PM.AmDemod PM.Ddc
  build-depends: theremin-clash

test-suite goertzel-test
  import: shared
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: GoertzelSpec.hs
  build-depends: pm-dsp
  ghc-options: -threaded

test-suite amdemod-test
  import: shared
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: AmDemodSpec.hs
  build-depends: pm-dsp
  ghc-options: -threaded

test-suite ddc-test
  import: shared
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: DdcSpec.hs
  build-depends: pm-dsp
  ghc-options: -threaded -rtsopts

executable clash
  import: shared
  main-is: bin/Clash.hs
  build-depends: clash-ghc
