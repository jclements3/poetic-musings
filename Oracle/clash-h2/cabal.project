-- The irig package is the sim-verified IRIG-B core (IRIG/clash); the
-- SystemUart model instantiates its time engine for the 0x4034/0x4040
-- registers.
packages: . ../../IRIG/clash ../pm-lib ../pm-wspr ../pm-vision ../pm-net

write-ghc-environment-files: always

-- -O2 on both local libraries: the h2-boot simulation samples ~17M cycles
-- of the whole SoC model, and the default -O1 build roughly doubles its
-- wall time.
package clash-h2
  optimization: 2

package irig
  optimization: 2

package pm-lib
  optimization: 2

package pm-wspr
  optimization: 2

package pm-vision
  optimization: 2

package pm-net
  optimization: 2
