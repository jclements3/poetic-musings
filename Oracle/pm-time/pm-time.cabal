cabal-version: 2.4
name: pm-time
version: 0.1.0.0
synopsis: Station timebase - free-running RTC + PPS measurement, strobe stamp FIFO
description:
  Clash ports of MAIDEN/firmware/timebase/rtl (pps_discipline.vhd,
  strobe_latch.vhd), per LIBRARY.md's porting rule: widths explicit,
  upstream behaviour reproduced exactly, verified against the GHDL
  testbench cases (timebase_tb.vhd) in test/Spec.hs, plus PM.Dpll, the
  steered 10 MHz layer of GPS/DESIGN.md (test/DpllSpec.hs). Hedgehog
  reference-model properties in test/Prop.hs; see VERIFY.md.
build-type: Simple

common shared
  default-language: Haskell2010
  ghc-options: -Wall -fplugin GHC.TypeLits.Extra.Solver -fplugin GHC.TypeLits.Normalise -fplugin GHC.TypeLits.KnownNat.Solver
  build-depends: base, Cabal, clash-prelude >= 1.8, ghc-typelits-natnormalise, ghc-typelits-extra, ghc-typelits-knownnat
  default-extensions:
    BangPatterns BinaryLiterals ConstraintKinds DataKinds DefaultSignatures
    DeriveAnyClass DeriveGeneric DerivingStrategies FlexibleContexts
    KindSignatures MagicHash NoStarIsType NumericUnderscores
    ScopedTypeVariables TemplateHaskell TypeApplications TypeFamilies
    TypeOperators NoImplicitPrelude

library
  import: shared
  hs-source-dirs: src
  exposed-modules: PM.StrobeLatch
                   PM.PpsDiscipline
                   PM.Dpll

test-suite time-test
  import: shared
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  build-depends: pm-time
  ghc-options: -threaded

test-suite dpll-test
  import: shared
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: DpllSpec.hs
  build-depends: pm-time
  ghc-options: -threaded -O2

test-suite time-prop
  import: shared
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Prop.hs
  build-depends: pm-time, hedgehog
  ghc-options: -threaded

executable clash
  import: shared
  main-is: bin/Clash.hs
  build-depends: clash-ghc
